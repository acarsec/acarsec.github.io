---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { social } from '../data/social';
import { activity } from '../data/activity';
---
<BaseLayout title="About" description="Background, education, credentials, and contact details for Ebu Bekir Acar."><main id="main" class="shell about-main"><header class="page-heading"><p class="eyebrow">ABOUT / EBU BEKIR ACAR</p><h1>A security mindset.<br/><span class="accent">Always learning.</span></h1><p class="lead">{site.bio}</p></header><section class="section split"><h2>Background</h2><div class="body-copy"><p>My work builds on a defensive security foundation while I develop practical skills in offensive security, red teaming, bug bounty research, and Python tooling.</p><p>I practice on TryHackMe and Hack The Box, maintain a technical blog, and plan to expand into educational video content. My long-term interests connect threat intelligence, CSIRT, and OSINT with both offense and defense.</p></div></section><section class="section split"><h2>Education</h2><ul class="plain-list">{site.education.map(item => <li>{item}</li>)}</ul></section><section class="section split"><div><h2>Training & credentials</h2><a class="text-link" href={site.credentials} target="_blank" rel="noopener noreferrer">Verified badges on Credly ↗</a></div><div class="timeline">{[...activity].reverse().map(entry => <article><time datetime={entry.date}>{entry.date}</time><h3>{entry.msg.replace(/^(earned|completed) /,'')}</h3></article>)}</div></section><section class="section split"><div><h2>Let’s connect</h2><a class="contact-email" href={`mailto:${site.email}`}>{site.email} ↗</a></div><div class="social-links">{social.map(item => <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label} ↗</a>)}</div></section></main></BaseLayout>
