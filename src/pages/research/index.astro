---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentIndex from '../../components/ContentIndex.astro';
import { publicContent, toRecord } from '../../lib/content';
const data = await publicContent();
const records = data.publications.filter(entry => entry.data.contentType === "research").map(toRecord);

---
<BaseLayout title="Research" description="Focused security research, reproducible methods, findings, and limitations."><ContentIndex title="Questions worth exploring" description="Focused security research, reproducible methods, findings, and limitations." records={records} scope="blog" /></BaseLayout>
