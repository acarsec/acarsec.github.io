---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { publicContent, toRecord } from '../lib/content';
import { site } from '../data/site';
import { profilePlatforms } from '../data/platforms';
import { skills } from '../data/skills';
import { activity } from '../data/activity';
const data = await publicContent();
const featured = [...data.publications, ...data.projects].filter(entry => entry.data.featured);
---
<BaseLayout title="Security portfolio & technical notebook"><main id="main" class="shell"><section class="hero"><div class="hero-copy"><span class="availability"><span></span> OPEN TO FREELANCE WORK</span><p class="eyebrow">EBU BEKIR ACAR / CYBERSECURITY ANALYST</p><h1>Stay curious.<br/>Think critically.<br/><span class="accent">Build more securely.</span></h1><p class="lead">A blue team foundation. An offensive security mindset in progress. I explore risks, document what I learn, and bring that perspective to freelance security work.</p><div class="actions"><a class="button primary" href="/blog/">Explore the notebook <span>↗</span></a><a class="button ghost" href="/labs/">View the lab archive <span>↗</span></a></div><p class="hero-footnote mono">DEFENSE → INVESTIGATION → UNDERSTANDING</p></div><aside class="hero-panel" aria-label="Profile summary"><div class="panel-bar mono"><span>PROFILE / ACARSEC</span><span class="accent">●</span></div><div class="profile-monogram">ea<span>.</span></div><h2>{site.name}</h2><p class="muted">Cybersecurity Analyst</p><dl><div><dt>Foundation</dt><dd>Blue team & network security</dd></div><div><dt>Exploring</dt><dd>Red teaming & bug bounty</dd></div><div><dt>Education</dt><dd>Master’s in cybersecurity · ongoing</dd></div></dl><a class="panel-link" href="/about/">More about me <span>↗</span></a></aside></section><div class="focus-strip mono"><span>BLUE TEAM FOUNDATION</span><span>OFFENSIVE SECURITY</span><span>PYTHON TOOLING</span><span>CONTINUOUS LEARNING</span></div>
<section id="about" class="section split"><div><p class="eyebrow">01 / THE PERSON BEHIND THE WORK</p><h2>Curious by nature.<br/>Methodical by practice.</h2></div><div class="body-copy"><p>{site.bio}</p><p>I practice regularly on TryHackMe and Hack The Box, explore bug bounty programs, and share educational cybersecurity content. My long-term interests span threat intelligence, CSIRT, and OSINT.</p><a class="text-link" href="/about/">My background ↗</a></div></section>
{featured.length > 0 && <section class="section"><div class="section-head"><div><p class="eyebrow">SELECTED WORK</p><h2>Worth a closer look.</h2></div></div><div class="content-grid">{featured.map(entry => <ContentCard record={toRecord(entry)}/>)}</div></section>}
<section id="blog" class="section"><div class="section-head"><div><p class="eyebrow">02 / RECENT PUBLICATIONS</p><h2>From the notebook<span class="accent">.</span></h2></div><a class="text-link" href="/blog/">All publications ↗</a></div><div class="content-grid home-grid">{data.publications.slice(0,3).map(entry => <ContentCard record={toRecord(entry)}/>)}</div></section>
<section id="skills" class="section split"><div><p class="eyebrow">03 / TOOLKIT</p><h2>The tools behind<br/>the questions.</h2><p class="muted section-note">Tools and languages I work with<br/>and continue to develop.</p></div><div class="skill-list">{skills.map(group => <div class="skill-row"><h3>{group.title}</h3><div class="chips">{group.items.map(item => <span>{item}</span>)}</div></div>)}</div></section>
<section id="projects" class="section archive-callout"><div><p class="eyebrow">04 / PRACTICE & BUILDING</p><h2>Learn by doing.<br/>Keep a record.</h2><p class="muted">Lab notes capture the practice. Write-ups explain the evidence.<br/>Projects document the tools built along the way.</p></div><div class="archive-links"><a href="/labs/"><span class="mono">/ LABS</span><strong>Hands-on practice</strong><span>↗</span></a><a href="/projects/"><span class="mono">/ PROJECTS</span><strong>Tools & experiments</strong><span>↗</span></a></div></section>
<section id="platforms" class="section"><div class="section-head"><div><p class="eyebrow">05 / TRAINING & RESEARCH PROFILES</p><h2>Where I keep learning.</h2></div><p class="muted">Training platforms and bounty profiles.<br/>Each is a different part of the journey.</p></div><div class="platform-grid">{profilePlatforms.map(platform => <a class="platform-card" href={platform.href} target="_blank" rel="noopener noreferrer"><span class="platform-symbol mono">{platform.badge}</span><span><strong>{platform.name}</strong><small>{platform.handle === 'N/A' ? 'View profile' : platform.handle}</small></span><span class="platform-arrow">↗</span></a>)}</div></section>
<section id="activity" class="section split"><div><p class="eyebrow">06 / BACKGROUND</p><h2>A foundation<br/>built over time.</h2><a class="text-link" href={site.credentials} target="_blank" rel="noopener noreferrer">Verified credentials ↗</a></div><div class="timeline">{[...activity].reverse().map(entry => <article><time datetime={entry.date}>{entry.date}</time><h3>{entry.msg.replace(/^(earned|completed) /, '')}</h3></article>)}</div></section>
<section id="hire" class="section contact-section"><div><span class="availability"><span></span> LET’S FIND THE RIGHT SCOPE</span><h2>Security work.<br/><span class="accent">With a practical focus.</span></h2><p class="lead">Open to short-term freelance engagements. Share your project, scope, and timeline so we can discuss fit and availability.</p><a class="contact-email" href={`mailto:${site.email}`}>{site.email} ↗</a></div><div class="service-panel"><p class="eyebrow">HOW I CAN HELP</p><ul>{site.services.map(service => <li><span class="accent" aria-hidden="true">↗</span>{service}</li>)}</ul></div></section></main></BaseLayout>
