---
import ContentCard from './ContentCard.astro';
import ContentFilters from './ContentFilters.astro';
import { blogNavigation } from '../data/navigation';
import { safeJson } from '../lib/urls';
import type { IndexRecord } from '../lib/content';
interface Props { title: string; description: string; records: IndexRecord[]; scope?: string; eyebrow?: string; }
const { title, description, records, scope = 'blog', eyebrow = 'THE SECURITY NOTEBOOK' } = Astro.props;
---
<main id="main" class="shell archive-main"><header class="page-heading"><p class="eyebrow">{eyebrow}</p><h1>{title}<span class="accent">.</span></h1><p class="lead">{description}</p></header>{scope === 'blog' && <nav class="blog-tabs" aria-label="Publication types">{blogNavigation.map(item => <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}<a href="/categories/">Categories ↗</a><a href="/tags/">Tags ↗</a></nav>}<section class="content-index" data-scope={scope}><ContentFilters records={records} scope={scope}/><p class="result-count" aria-live="polite" aria-atomic="true">{records.length} {records.length === 1 ? 'entry' : 'entries'}</p><div class="content-grid">{records.map(record => <ContentCard record={record}/>)}</div><div class="empty-state" hidden={records.length > 0}><span class="mono accent">/ NOTHING HERE YET</span><h2>{records.length ? 'No matching entries.' : 'The archive starts with real work.'}</h2><p>{records.length ? 'Try another query or reset the filters.' : 'No public entries in this collection yet. New work will appear here when it is ready.'}</p><a class="text-link" href="/blog/">Explore the notebook ↗</a></div><div class="pagination" hidden><button type="button" data-prev class="button ghost">← Previous</button><span data-page-info></span><button type="button" data-next class="button ghost">Next →</button></div><script type="application/json" class="index-data" set:html={safeJson(records)}/></section></main>
<script>import '../scripts/content-index';</script>
