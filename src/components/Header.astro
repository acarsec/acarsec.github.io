---
import { navigation } from '../data/navigation';
const path = Astro.url.pathname;
const active = (href: string) => href === '/' ? path === '/' : href === '/blog/' ? path.startsWith('/blog/') || path.startsWith('/notes/') || path.startsWith('/writeups/') : path.startsWith(href);
---
<header class="site-header"><div class="shell nav-row"><a class="brand" href="/" aria-label="Ebu Bekir Acar home"><span class="brand-mark">ea.</span><span class="brand-label">acarsec<span class="brand-caption">SECURITY / RESEARCH</span></span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" hidden>Menu <span aria-hidden="true">＋</span></button><nav id="main-navigation" aria-label="Main navigation">{navigation.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav><a class="header-contact" href="/#hire">Let’s talk <span aria-hidden="true">↗</span></a></div></header>
<script>import '../scripts/navigation';</script>
