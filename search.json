---
layout: none
---
[
  {% for post in site.posts %}
  {
    "title"  : "{{ post.title | escape }}",
    "url"    : "{{ post.url | relative_url }}",
    "date"   : "{{ post.date | date: '%Y-%m-%d' }}",
    "tags"   : "{{ post.tags | join: ', ' }}",
    "type"   : "post",
    "prefix" : "~/blog/",
    "excerpt": "{{ post.excerpt_custom | default: post.excerpt | strip_html | truncate: 120 | escape }}"
  },
  {% endfor %}
  {% for project in site.projects %}
  {
    "title"  : "{{ project.project_name | escape }}",
    "url"    : "{{ project.url | relative_url }}",
    "date"   : "{{ project.last_updated }}",
    "tags"   : "{{ project.tags | join: ', ' }}",
    "type"   : "{{ project.project_type }}",
    "prefix" : "~/projects/",
    "excerpt": "{{ project.short_description | escape }}"
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
